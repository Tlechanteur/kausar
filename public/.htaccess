# Kausar, Apache (OVH) : copié tel quel à la racine du site compilé
Options -Indexes
DirectoryIndex index.html

# les fichiers de /_astro portent une empreinte dans leur nom : on peut les garder un an en cache
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|png|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
