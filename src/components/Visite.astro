---
/**
 * La visite virtuelle Google Street View : une photo et un bouton.
 * L'iframe Google ne se charge qu'au clic, donc aucun cookie Google avant que le visiteur le demande.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  url: string;
  photo: ImageMetadata;
  /** Le titre de l'iframe, lu par les lecteurs d'écran. */
  titre: string;
}
const { url, photo, titre } = Astro.props;
---
<div class="visite" data-visite={url} data-visite-titre={titre}>
  <Image src={photo} alt="" widths={[640, 1000, 1400]} sizes="(min-width: 76rem) 76rem, 100vw" width={1400} class="visite__photo" />
  <a class="btn btn--rouge visite__bouton" href={url} target="_blank" rel="noopener" data-visite-bouton>Lancer la visite virtuelle</a>
  <p class="visite__note">Le bouton charge Google Street View, qui dépose ses propres cookies.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-visite]').forEach((zone) => {
    zone.querySelector('[data-visite-bouton]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = zone.dataset.visite!;
      f.title = zone.dataset.visiteTitre || 'Visite virtuelle sur Google Street View';
      f.allowFullscreen = true;
      f.allow = 'accelerometer; gyroscope; fullscreen';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      zone.replaceChildren(f);
      zone.classList.add('is-chargee');
      f.focus();
    });
  });
</script>
