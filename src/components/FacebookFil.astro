---
/**
 * Le fil de la page Facebook de Kausar (module « Page » de Facebook).
 * Comme la visite virtuelle, il ne se charge qu'au clic : aucun cookie Facebook avant que le visiteur le demande.
 */
interface Props {
  /** L'adresse de la page Facebook. */
  page: string;
}
const { page } = Astro.props;
const src = `https://www.facebook.com/plugins/page.php?${new URLSearchParams({
  href: page,
  tabs: 'timeline',
  width: '500',
  height: '760',
  small_header: 'false',
  adapt_container_width: 'true',
  hide_cover: 'false',
  show_facepile: 'false',
  locale: 'fr_FR',
})}`;
---
<div class="fbfil" data-fbfil={src}>
  <div class="fbfil__attente">
    <p class="fbfil__titre">Les dernières publications de Kausar</p>
    <p>Les promotions et les nouveautés, directement depuis notre page Facebook.</p>
    <button type="button" class="btn btn--rouge" data-fbfil-bouton>Afficher les publications</button>
    <p class="fbfil__note">Le bouton charge Facebook, qui dépose ses propres cookies.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fbfil]').forEach((zone) => {
    zone.querySelector('[data-fbfil-bouton]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = zone.dataset.fbfil!;
      f.title = 'Les dernières publications de Kausar sur Facebook';
      f.allow = 'encrypted-media; clipboard-write; web-share';
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      zone.replaceChildren(f);
      zone.classList.add('is-chargee');
      f.focus();
    });
  });
</script>
