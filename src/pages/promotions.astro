---
/**
 * Promotions : les promos sont publiées sur la page Facebook de Kausar.
 * La page explique où les trouver et renvoie vers Facebook dans un nouvel onglet.
 * (Le module « Page » de Facebook a été essayé : il n'affiche plus les publications, même connecté.)
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { facebook } from '../data/magasins';
import { lien } from '../lib/lien';
import fruits from '../assets/photos/fruits02slb.jpg';
---
<Base
  title="Promotions et nouveautés | Kausar Liège, Verviers et Alleur"
  description="Les promotions, les nouveaux produits et les nouvelles références des magasins Kausar, publiés sur la page Facebook de Kausar."
  page="promotions"
>
  <section class="wrap promos">
    <div class="promos__txt">
      <h1>Nos promotions</h1>
      <p class="promos__lede">Kausar publie ses promotions sur sa page Facebook, avec les nouveaux produits et les nouvelles références de nos magasins.</p>
      <p class="hero__actions">
        <a class="btn btn--rouge" href={facebook} target="_blank" rel="noopener">Voir les promos sur Facebook<span class="sr-only"> (nouvel onglet)</span></a>
        <a class="btn btn--creux" href={lien('/contact/')}>Trouver mon magasin</a>
      </p>
      <ul class="promos__points" role="list">
        <li><span class="sq" aria-hidden="true" style="--c: var(--rouge)"></span>Les promotions et les nouveautés de nos magasins.</li>
        <li><span class="sq" aria-hidden="true" style="--c: var(--vert)"></span>Nos astuces cuisine et beauté.</li>
        <li><span class="sq" aria-hidden="true" style="--c: var(--ciel)"></span>Abonnez-vous à la page pour les voir dès leur parution.</li>
      </ul>
    </div>
    <a class="fbcarte" href={facebook} target="_blank" rel="noopener">
      <Image src={fruits} alt="" widths={[500, 800, 1000]} sizes="(min-width: 60rem) 32rem, 100vw" width={1000} loading="eager" class="fbcarte__photo" />
      <span class="fbcarte__bas">
        <span class="fbcarte__nom">Kausar Group sur Facebook</span>
        <span class="fbcarte__lien">facebook.com/KausarCity<span class="sr-only"> (nouvel onglet)</span></span>
      </span>
    </a>
  </section>
</Base>
