---
/**
 * Nos magasins : un petit encart cliquable par magasin (photo, nom, adresse, état en direct),
 * qui mène à la page du magasin pour le détail.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { magasins } from '../data/magasins';
import { lien } from '../lib/lien';
---
<Base
  title="Nos six magasins | Kausar Liège, Verviers et Alleur"
  description="Les six magasins Kausar : Ethnic Supermarket, Ethnic Market Cathédrale et Place du Marché, Librairie Market, Exotic Market Verviers et Exotic City."
  page="contact"
>
  <section class="wrap page-tete">
    <h1>Nos six magasins</h1>
    <p data-maintenant>Liège, Verviers et Alleur.</p>
  </section>

  <ul class="wrap cartes" role="list">
    {magasins.map((m, i) => (
      <li id={m.slug} style={`--c:${m.couleur}; --i:${i % 3}`} data-reveal data-slug={m.semaine ? m.slug : undefined} data-semaine={m.semaine ? JSON.stringify(m.semaine) : undefined}>
        <a class="carte" href={lien(`/${m.page}/`)}>
          <span class="carte__photo">
            <Image src={m.photos[0].src} alt="" widths={[400, 640]} sizes="(min-width: 76rem) 24rem, (min-width: 60rem) 31vw, 48vw" width={640} style={m.photos[0].pos ? `object-position:${m.photos[0].pos}` : undefined} loading={i < 3 ? 'eager' : 'lazy'} />
          </span>
          <span class="carte__corps">
            <h2>{m.enseigne}</h2>
            <span class="carte__adresse">{m.rue}, {m.ville.replace(/^\d+ /, '')}</span>
            {m.semaine ? <span class="etat mag-etat" data-etat={m.slug}></span> : <span class="etat">Pour les professionnels</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
