{
  // Déploiement Cloudflare Workers : les fichiers statiques générés par Astro
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kausar",
  "compatibility_date": "2026-10-01",
  // Pas de copie publique sur *.workers.dev (contenu en double pour Google) : le site est servi sur kausar.be et www.kausar.be
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kausar.be", "custom_domain": true },
    { "pattern": "www.kausar.be", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  }
}
